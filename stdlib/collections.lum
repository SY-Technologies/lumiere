/** Méthodes communes à toute séquence ordonnée (Liste et ListeFixe). */
classe Liste
{
    /** Retourne le nombre d'éléments de la séquence. */
    fonction taille() -> Entier
    {
    }

    /** Retourne vrai si la séquence ne contient aucun élément. */
    fonction vide() -> Logique
    {
    }

    /** Retourne vrai si la séquence contient la valeur donnée. */
    fonction contient(valeur : Universel) -> Logique
    {
    }

    /** Assemble la représentation de tous les éléments en un seul texte, séparés par séparateur. */
    fonction joindre(séparateur : Texte) -> Texte
    {
    }

    /** Ajoute un élément à la fin de la liste et retourne la nouvelle longueur. */
    fonction ajouter(élément : Universel) -> Entier
    {
    }

    /** Insère un élément à l'indice donné et retourne cet indice. */
    fonction inserer(position : Entier, valeur : Universel) -> Entier
    {
    }

    /** Retire l'élément à l'indice donné et le retourne. */
    fonction retirer_a(position : Entier) -> Universel
    {
    }

    /** Convertit la liste en une ListeFixe de taille exacte (échoue si la taille diffère). */
    fonction en_liste_fixe(longueur : Entier) -> ListeFixe
    {
    }

    /** Convertit la liste en un Ensemble, en supprimant les doublons. */
    fonction en_ensemble() -> Ensemble
    {
    }
}

/**
 * Séquence ordonnée immuable : ni sa taille ni ses éléments ne changent après
 * sa construction. Elle est comparée par son contenu et peut donc servir de clé
 * de dictionnaire.
 */
classe ListeFixe
{
    /** Retourne le nombre d'éléments de la séquence. */
    fonction taille() -> Entier
    {
    }

    /** Retourne vrai si la séquence ne contient aucun élément. */
    fonction vide() -> Logique
    {
    }

    /** Retourne vrai si la séquence contient la valeur donnée. */
    fonction contient(valeur : Universel) -> Logique
    {
    }

    /** Assemble la représentation de tous les éléments en un seul texte, séparés par séparateur. */
    fonction joindre(séparateur : Texte) -> Texte
    {
    }

    /** Convertit la séquence en une Liste dynamique redimensionnable. */
    fonction en_liste() -> Liste
    {
    }
}

/** Table d'association ordonnée reliant des clés à des valeurs. */
classe Dictionnaire
{
    /** Retourne le nombre de paires clé-valeur du dictionnaire. */
    fonction taille() -> Entier
    {
    }

    /** Retourne vrai si le dictionnaire ne contient aucune paire. */
    fonction vide() -> Logique
    {
    }

    /** Retourne vrai si le dictionnaire contient la clé donnée. */
    fonction contient(clé : Universel) -> Logique
    {
    }

    /** Retourne la liste des clés du dictionnaire. */
    fonction clés() -> Liste
    {
    }

    /** Retourne la liste des valeurs du dictionnaire. */
    fonction valeurs() -> Liste
    {
    }

    /** Retourne la liste des paires clé-valeur, chaque paire étant une liste fixe de deux éléments. */
    fonction paires() -> Liste
    {
    }

    /** Retire et retourne la valeur associée à la clé ; échoue si la clé est absente. */
    fonction retirer(clé : Universel) -> Universel
    {
    }
}
/**
 * Collection non ordonnée par contrat où chaque élément n'apparaît qu'une fois.
 * Les éléments conservent leur ordre d'insertion pour que le parcours soit
 * reproductible, et suivent la règle des clés de dictionnaire.
 */
classe Ensemble
{
    /** Retourne le nombre d'éléments de l'ensemble. */
    fonction taille() -> Entier
    {
    }

    /** Retourne vrai si l'ensemble ne contient aucun élément. */
    fonction vide() -> Logique
    {
    }

    /** Retourne vrai si l'ensemble contient la valeur donnée. */
    fonction contient(élément : Universel) -> Logique
    {
    }

    /** Assemble la représentation de tous les éléments en un seul texte, séparés par séparateur. */
    fonction joindre(séparateur : Texte) -> Texte
    {
    }

    /** Ajoute un élément ; retourne vrai s'il n'était pas déjà présent. */
    fonction ajouter(élément : Universel) -> Logique
    {
    }

    /** Retire un élément ; retourne faux s'il était absent. */
    fonction retirer(élément : Universel) -> Logique
    {
    }

    /** Convertit l'ensemble en une Liste, dans l'ordre d'insertion. */
    fonction en_liste() -> Liste
    {
    }

    /** Retourne un ensemble contenant les éléments des deux ensembles. */
    fonction union(autre : Ensemble) -> Ensemble
    {
    }

    /** Retourne un ensemble contenant les éléments présents dans les deux ensembles. */
    fonction intersection(autre : Ensemble) -> Ensemble
    {
    }

    /** Retourne un ensemble contenant les éléments absents de l'autre ensemble. */
    fonction différence(autre : Ensemble) -> Ensemble
    {
    }

    /** Retourne vrai si tous les éléments sont présents dans l'autre ensemble. */
    fonction sous_ensemble_de(autre : Ensemble) -> Logique
    {
    }
}
