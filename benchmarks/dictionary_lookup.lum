fonction principal() {
    soit index = {}
    soit i = 0
    tant que i < 50000 {
        index["cle" + i] = i
        i = i + 1
    }

    soit total = 0
    soit j = 0
    tant que j < 50000 {
        total = total + index["cle" + j]
        j = j + 1
    }

    afficher(index.taille())
    afficher(total)
}
